APP_ORIGIN=http://localhost
APP_PORT=80
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace-root-password-alphanumeric
MONGO_APP_USER=tracker
MONGO_APP_PASSWORD=replace-app-password-alphanumeric
MONGO_DB=tracker
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
# CI/CD sets IMAGE_PREFIX (ghcr.io/owner/repository) and IMAGE_TAG (commit SHA).
IMAGE_PREFIX=tracker
IMAGE_TAG=local
